# ============================================================
# importadoraRealtime · .env.ejemplo
# Variables necesarias para funcionar en producción (nube).
# Copiar como .env y completar los valores. NUNCA versionar .env.
# ============================================================

# --- Entorno -------------------------------------------------
# Valor fijo en producción. Activa la validación de orígenes
# (REALTIME_ALLOWED_ORIGINS no puede ser * fuera de desarrollo).
APP_ENV=production

# --- Base de datos -------------------------------------------
# Todos los valores vienen del servicio PostgreSQL en Railway.
# Ir a: Railway → proyecto → servicio "Postgres" → pestaña Variables.

# Host interno de la base de datos.
# En local: localhost
# En Railway (red interna): postgres.railway.internal
DB_HOST=localhost

# Puerto de PostgreSQL. En Railway es siempre 5432 (red interna).
DB_PORT=5432

# Nombre de la base de datos.
# En local: el nombre que usaste al crear la DB en pgAdmin (ej. Importadora).
# En Railway: por defecto es "railway" (ver variable PGDATABASE en el servicio Postgres).
DB_DATABASE=Importadora

# Usuario de la base de datos.
# En local: postgres (u otro usuario que hayas creado).
# En Railway: ver variable PGUSER en el servicio Postgres (por defecto "postgres").
DB_USER=postgres

# Contraseña de la base de datos.
# En local: la que definiste al instalar PostgreSQL.
# En Railway: ver variable PGPASSWORD en el servicio Postgres.
DB_PASSWORD=

# --- Orígenes WebSocket --------------------------------------
# Lista separada por comas de los orígenes autorizados para
# conectarse al WebSocket desde el navegador.
# En local: http://localhost:5173
# En producción: NO puede ser * → el servidor rechazará el arranque.
# En Railway: la URL pública HTTPS del frontend.
#   Ir a: Railway → servicio Frontend → Settings → Networking → Domain.
#   Ejemplo: https://iponline.up.railway.app
REALTIME_ALLOWED_ORIGINS=http://localhost:5173

