# ============================================================
# importadoraRealtime · .env.railway
# Variables del servicio iponline-ws en Railway → Variables.
# NUNCA escribir aquí contraseñas: este archivo está en el repositorio. Usar referencias de Railway ${{...}}.
# PORT lo inyecta Railway (no crearlo).
# ============================================================

# --- Entorno --------------------------------------------------
APP_ENV=production

# --- Base de datos (la misma de la API, con un usuario propio de solo lectura) ---
# Railway → servicio Postgres → Variables.
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
# Recomendado: el rol importadora_realtime (mínimo privilegio, lo crea startdb / la migración 20261129). Con postgres funciona, pero el log avisa.
DB_USER=importadora_realtime
# La contraseña que se le asigna a ese rol una vez en la base: ALTER ROLE importadora_realtime PASSWORD '…'; (escribirla en Railway, no aquí).
DB_PASSWORD=<asignar en Railway>

# --- Navegador -------------------------------------------------
# Railway → servicio frontend (iponline) → Settings → Networking → Domain, con https://. No puede ser *.
REALTIME_ALLOWED_ORIGINS=https://<dominio-del-frontend>.up.railway.app
