# ============================================================
# importadoraRealtime · .env.railway
# Variables a configurar en Railway → servicio iponline-ws → Variables.
# Las variables marcadas con [Railway auto] las inyecta Railway;
# no las crees manualmente.
# ============================================================

# --- Entorno -------------------------------------------------
APP_ENV=production

# [Railway auto] Railway inyecta PORT automáticamente al contenedor.
# El servicio lo lee con prioridad sobre APP_PORT.

# --- Base de datos -------------------------------------------
# Origen: Railway → servicio "Postgres" → pestaña Variables.
# Puedes usar referencias de Railway para que se actualicen solas.

# ${{Postgres.PGHOST}}  →  postgres.railway.internal
DB_HOST=${{Postgres.PGHOST}}

# ${{Postgres.PGPORT}}  →  5432
DB_PORT=${{Postgres.PGPORT}}

# ${{Postgres.PGDATABASE}}  →  railway
DB_DATABASE=${{Postgres.PGDATABASE}}

# ${{Postgres.PGUSER}}  →  postgres
DB_USER=${{Postgres.PGUSER}}

# ${{Postgres.PGPASSWORD}}  →  <contraseña generada por Railway>
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# --- Orígenes WebSocket --------------------------------------
# Origen: Railway → servicio "iponline" (frontend) → Settings → Networking → Domain.
# Usar la URL HTTPS que Railway generó para el frontend.
# Ejemplo: https://iponline.up.railway.app
REALTIME_ALLOWED_ORIGINS=https://<dominio-del-frontend>.up.railway.app

